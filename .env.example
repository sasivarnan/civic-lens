NODE_ENV=development
# Temporary hackathon access. Keep false for normal use.
DEMO_MODE=false
APP_ORIGIN=http://localhost:5173
PORT=3000
DATABASE_URL=postgres://civiclens:civiclens@localhost:5432/civiclens
AUTH_SECRET=replace-with-at-least-32-random-characters
EMAIL_SERVER=smtp://localhost:1025
EMAIL_FROM=CivicLens <hello@civiclens.local>
S3_ENDPOINT=http://localhost:3900
S3_REGION=garage
S3_BUCKET=civiclens
S3_ACCESS_KEY=replace-with-GK-and-32-hex-characters
S3_SECRET_KEY=replace-with-64-random-hex-characters
MODEL_PROVIDER=ollama
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_GEMMA_MODEL=gemma4:12b-mlx
EMBEDDING_ENDPOINT=http://127.0.0.1:11434/api/embed
EMBEDDING_MODEL=embeddinggemma-2:740m
# Hosted model and storage choices remain on hold.
# GEMINI_API_KEY=
# GEMMA_MODEL=gemma-4-26b-a4b-it
# EMBEDDING_SECRET=

# Longest image edge sent to local Gemma; approved storage images keep their resolution.
OLLAMA_IMAGE_SIZE=512
